name=bt-hw
version=1.0
release=1
summary="a package that uses the hardware variables of the profile"
homepage=https://example.org/bt-hw
license=(MIT)
category=extra
build_type=custom

do_build() { :; }
do_install() {
	mkdir -p "$DESTDIR/usr/share/bt-hw"
	printf '%s\n' "$VIDEO_CARDS" "$QUIRKS" >"$DESTDIR/usr/share/bt-hw/hw"
}
